
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corelife",
  "main": "backend/worker.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}